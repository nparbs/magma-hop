{
  "name": "updraft",
  "private": true,
  "version": "0.1.0",
  "description": "An endless bouncing climb up a sky tower, with a global height board.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node dist-server/index.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
